# Example environment variables for youtube-downloader
# Keep real secrets in .env and never commit them.

# Optional shared key (your current .env uses lowercase 'key').
key=key

# Rate limiter / temporary ban settings
RATE_LIMIT_ENABLED=1
RATE_LIMIT_API_ONLY=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_BAN_SECONDS=300

# Forward original client IP from incoming X-Forwarded-For to yt-dlp requests
YTDLP_USE_X_FORWARDED_FOR=1

# The number of proxies this is behind (e.g. Cloudflare, etc.)
PROXIES=0